# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/
.eggs/
.installed.cfg

# Virtual environments
.venv/
venv/
env/

# Test / lint / type caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# Runtime data: observations, caches, the ledger (data/state.json) and anything else a run
# writes under data/ is never committed; only the folder placeholders are. A Breakthrough
# Listen coarse channel is hundreds of MB; everything here is regenerable or re-downloadable.
data/**
!data/**/
!data/**/.gitkeep

# Generated reports, candidate lists, plots and share bundles (reports/share).
reports/**
!reports/**/
!reports/.gitkeep

# Browser-automation artefacts
.playwright-mcp/

# Raw observation formats are ignored by extension, so a deliberate regression fixture
# under tests/ would be swallowed too. Re-include them if fixtures are ever added.
!tests/**/*.fil
!tests/**/*.h5
!tests/**/*.hdf5

# Secrets. `share --to github` reads AI_SETI_GITHUB_TOKEN from the environment (never from a
# file); a Discord/Slack webhook URL passed via `--webhook` is itself a credential, so a
# personal config kept alongside the tracked configs/default.json must not be committed.
.env
.env.*
!.env.example
configs/*.local.json

# Local scratch
*.fil
*.h5
*.hdf5
*.part
*.tmp
*.log
*.orig
*.rej
.streamlit/*
!.streamlit/config.toml
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/
